{
  "name": "dastak",
  "private": true,
  "version": "1.0.0",
  "description": "One-question-at-a-time field visit workflow prototype for a 600x600 head-worn display (Meta Ray-Ban Display). Not clinically validated.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build-registry.js",
    "verify": "node verify.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include=public/js/**/*.js --test-coverage-include=api/**/*.js --test-coverage-include=scripts/**/*.js test/unit/",
    "test:e2e": "playwright test --project=local",
    "test:deployed": "playwright test --project=deployed",
    "test:all": "npm run verify && npm test && npm run test:e2e",
    "report": "node scripts/report.js"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
