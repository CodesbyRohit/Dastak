{
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [{ "source": "/", "destination": "/glasses.html" }],
  "headers": [
    {
      "source": "/icon-96.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/glasses.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
