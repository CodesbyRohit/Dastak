{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dastak-orpin.vercel.app/schema/protocol.schema.json",
  "title": "Dastak Protocol",
  "description": "A data-only protocol definition interpreted by the Dastak engine (public/engine.js). Structural rules that JSON Schema cannot express (transition targets, reachability, cycles, numeric grids, lifecycle requirements) are enforced by scripts/lib/validate-protocol.js. Passing this schema says nothing about clinical correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "start", "status", "version", "provenance", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique protocol identifier. Never change an ID that has shipped; add the old value to legacyIds instead."
    },
    "legacyIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true,
      "description": "Earlier identifiers for this protocol. Resolved by the API and migrated in device storage."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Human-readable label shown in the launcher and context band."
    },
    "start": {
      "type": "string",
      "description": "ID of the first step to render."
    },
    "status": {
      "type": "string",
      "enum": ["structural-test", "clinical-draft", "reviewed-demo", "clinically-approved"],
      "description": "Content lifecycle. structural-test: exercises engine structure; content is placeholder and must not be used clinically. clinical-draft: intended clinical content that has not been reviewed by a qualified person. reviewed-demo: reviewed by a named qualified person for demonstration use only; not approved for care. clinically-approved: approved for use by an accountable body; requires an approval reference."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this protocol file. Saved progress from a different version is not resumed."
    },
    "provenance": { "$ref": "#/definitions/provenance" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoredBy", "sources", "review"],
      "properties": {
        "authoredBy": {
          "type": "string",
          "minLength": 1,
          "description": "Who wrote this protocol file. Authorship is not a clinical source."
        },
        "sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Citations for the clinical content (document title, issuer, edition, section). Empty when there are none."
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "type": "string", "enum": ["unreviewed", "reviewed", "approved"] },
            "reviewer": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "scope": { "type": "string", "minLength": 1 },
            "approvalReference": { "type": "string", "minLength": 1 }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "type", "content_source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": {
          "type": "string",
          "enum": ["yesno", "choice", "count", "range", "info"],
          "description": "Frame type. The engine renders exactly one frame per step. (The former 'group' type was removed in Amendment 7: the engine never implemented it.)"
        },
        "content_source": {
          "type": "string",
          "minLength": 1,
          "description": "'UNSOURCED' or a statement of where this step's content came from."
        },
        "next": {
          "type": ["string", "null"],
          "description": "Next step ID; null ends the visit. Not used by yesno."
        },
        "danger": {
          "type": "boolean",
          "description": "Marks a referral frame (info type only). Recorded as a referral flag when the visit passes through it."
        },
        "referral": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rule": { "$ref": "#/definitions/rule" },
        "options": {
          "type": "array",
          "minItems": 2,
          "description": "Choice options: all plain strings, or all option objects. Mixing is rejected.",
          "anyOf": [
            { "items": { "type": "string", "minLength": 1 } },
            { "items": { "$ref": "#/definitions/option" } }
          ]
        },
        "onYes": { "type": "string" },
        "onNo": { "type": "string" },
        "unit": { "type": "string", "maxLength": 12 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "yesno" } } },
          "then": { "required": ["onYes", "onNo"] }
        },
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["count", "range"] } } },
          "then": { "required": ["min", "max", "step", "default", "next"] }
        },
        {
          "if": { "properties": { "type": { "const": "info" } } },
          "then": { "required": ["next"] }
        },
        {
          "if": { "properties": { "danger": { "const": true } }, "required": ["danger"] },
          "then": { "required": ["referral"] }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number"] },
        "next": {
          "type": ["string", "null"],
          "description": "Per-option next step. Falls through to the step's next when absent."
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "target"],
      "properties": {
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in"] },
            "value": {}
          },
          "allOf": [
            {
              "if": { "properties": { "op": { "enum": ["gt", "gte", "lt", "lte"] } } },
              "then": { "properties": { "value": { "type": "number" } } }
            },
            {
              "if": { "properties": { "op": { "const": "in" } } },
              "then": { "properties": { "value": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } } } }
            },
            {
              "if": { "properties": { "op": { "enum": ["eq", "neq"] } } },
              "then": { "properties": { "value": { "type": ["string", "number"] } } }
            }
          ]
        },
        "target": { "type": "string" }
      }
    }
  }
}
